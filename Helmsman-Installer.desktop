[Desktop Entry]
Version=1.0
Type=Application
Name=Install or update Helmsman
Name[ru]=Установить или обновить Helmsman
Comment=Download and install the latest stable Helmsman release
Comment[ru]=Установить последнюю стабильную версию Helmsman и плагин Decky
Icon=network-vpn
Categories=Network;Settings;
Exec=konsole --hold -e python3 -c "import atexit,os,subprocess,sys,tempfile; fd,path=tempfile.mkstemp(prefix='helmsman-installer-',suffix='.py'); os.close(fd); atexit.register(os.unlink,path); code=subprocess.call(['curl','--fail','--location','--proto','=https','--proto-redir','=https','--connect-timeout','20','--max-time','120','--output',path,'https://raw.githubusercontent.com/ISAIandCO/Helmsman/main/scripts/install-latest.py']); sys.exit(code or subprocess.call([sys.executable,path]))"
Terminal=false
StartupNotify=false
