[Desktop Entry]
Version=1.0
Type=Application
Name=Install or update Helmsman
Name[ru]=Установить или обновить Helmsman
Comment=Download and install the latest stable Helmsman release
Comment[ru]=Установить последнюю стабильную версию Helmsman и плагин Decky
Icon=network-vpn
Categories=Network;Settings;
Exec=bash -c "tmp=\\$(mktemp /tmp/helmsman-installer-XXXXXX.py) || exit 1; trap 'rm -f -- \\"\\$tmp\\"' EXIT; if curl --fail --location --proto '=https' --proto-redir '=https' --connect-timeout 20 --max-time 120 --output \\"\\$tmp\\" https://raw.githubusercontent.com/ISAIandCO/Helmsman/main/scripts/install-latest.py && python3 \\"\\$tmp\\"; then status=0; else status=\\$?; echo \\"Installation failed. Check the message above.\\"; fi; echo; echo \\"Press Enter to close...\\"; read -r _ || true; exit \\"\\$status\\""
Terminal=true
StartupNotify=false
