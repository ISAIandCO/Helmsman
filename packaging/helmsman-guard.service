[Unit]
Description=Helmsman early boot traffic guard
DefaultDependencies=no
After=local-fs.target
Before=network-pre.target NetworkManager.service systemd-networkd.service helmsman.service
Wants=network-pre.target
RequiresMountsFor=/opt/helmsman

[Service]
Type=oneshot
ExecStart=/opt/helmsman/current/Helmsman guard
RemainAfterExit=yes
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/opt/helmsman/state
CapabilityBoundingSet=CAP_NET_ADMIN CAP_CHOWN CAP_DAC_OVERRIDE

[Install]
WantedBy=sysinit.target
