[Unit]
Description=Helmsman connection service
After=helmsman-guard.service network.target
Requires=helmsman-guard.service
StartLimitIntervalSec=0
RequiresMountsFor=/opt/helmsman

[Service]
Type=simple
ExecStart=/opt/helmsman/current/Helmsman daemon --owner-uid @UID@
Restart=always
RestartSec=5
TimeoutStopSec=20
KillMode=control-group
RuntimeDirectory=helmsman
RuntimeDirectoryMode=0751
UMask=0077
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=no
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RestrictRealtime=yes
RestrictNamespaces=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK AF_PACKET
CapabilityBoundingSet=CAP_NET_ADMIN CAP_NET_RAW CAP_SETUID CAP_SETGID CAP_SETPCAP CAP_CHOWN CAP_DAC_OVERRIDE
ReadWritePaths=/opt/helmsman/state /run/helmsman
DevicePolicy=closed
DeviceAllow=/dev/net/tun rw
MemoryMax=512M
CPUWeight=20
OOMPolicy=stop
StandardOutput=null
StandardError=journal

[Install]
WantedBy=multi-user.target
